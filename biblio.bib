@ARTICLE{Alexopoulos2008-kq,
  title     = "Implementation of the Legendre Transform for track segment
               reconstruction in drift tube chambers",
  author    = "Alexopoulos, T and Bachtis, M and Gazis, E and Tsipolitis, G",
  abstract  = "In this study, we apply the geometrical properties of the
               Legendre transform in order to implement a segment
               reconstruction algorithm for drift tube chambers used in High
               Energy Physics experiments. The output signal of a drift tube
               chamber consists of a collection of circles, each of which
               corresponds to a drift tube and defines the trajectory of the
