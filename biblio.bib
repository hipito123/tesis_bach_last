@ARTICLE{grover,
  title     = "Implementing pure adaptive search with Grover's quantum
               algorithm",
  author    = "Bulger, D and Baritompa, W P and Wood, G R",
  abstract  = "Pure adaptive search (PAS) is an idealized stochastic algorithm
               for unconstrained global optimization. The number of PAS
               iterations required to solve a problem increases only linearly
               in the domain dimension. However, each iteration requires the
               generation of a random domain point uniformly distributed in the
               current improving region. If no regularity conditions are known
               to hold for the objective function, then this task requires a
               number of classical function evaluations varying inversely with
               the proportion of the domain constituted by the improving
               region, entirely counteracting the PAS apparent speedup. The
               Grover quantum computational search algorithm provides a way to
               generate the PAS iterates. We show that the resulting
               implementation, which we call the Grover adaptive search (GAS),
               realizes PAS for functions satisfying certain conditions, and we
               believe that, when quantum computers will be available, GAS will
               be a practical algorithm.",
  journal   = "J. Optim. Theory Appl.",
  publisher = "Springer Nature",
  volume    =  116,
  number    =  3,
  pages     = "517--529",
  month     =  mar,
  year      =  2003
}
